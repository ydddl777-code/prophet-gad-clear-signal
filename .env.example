# Clear Signal — environment variables
# Copy to .env for local dev, or set these in the Vercel project's
# Environment Variables settings for production. Never commit real values.

# ── ElevenLabs (existing — voice TTS) ──────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_GAD=
ELEVENLABS_VOICE_HULDAH=

# ── Stripe — Remnant Warning ebook purchase (new) ──────────────────────────
# 1. Create a Stripe account (or use the existing one) at https://dashboard.stripe.com
# 2. Secret key: Developers -> API keys -> "Secret key" (starts sk_live_... in
#    live mode, sk_test_... in test mode). Required.
STRIPE_SECRET_KEY=

# 3. (Recommended) Create a Product "Remnant Warning" in the Stripe Dashboard
#    -> Product catalog -> Add product, with a one-time Price. Copy that
#    Price's ID (starts price_...) here. If left blank, the server falls
#    back to building an inline $9.99 price automatically — see
#    STRIPE_BOOK_PRICE_USD_CENTS below.
STRIPE_BOOK_PRICE_ID=

# 4. Optional numeric fallback (in US cents) used only when
#    STRIPE_BOOK_PRICE_ID is not set. Defaults to 999 ($9.99) if unset.
STRIPE_BOOK_PRICE_USD_CENTS=999

# 5. Webhook signing secret: Developers -> Webhooks -> Add endpoint
#    -> URL: https://<your-domain>/api/webhook/stripe
#    -> Events to send: checkout.session.completed
#    Copy the endpoint's "Signing secret" (starts whsec_...) here.
STRIPE_WEBHOOK_SECRET=
